# ---------- App ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-32
ADMIN_EMAILS=you@email.com
ENCRYPTION_KEY=                # 32 bytes base64: openssl rand -base64 32

# ---------- Database (Neon, Supabase or local Postgres) ----------
DATABASE_URL=postgresql://user:password@localhost:5432/cvgen

# ---------- Auth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=CVGen <no-reply@example.com>

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------- File storage ----------
STORAGE_DRIVER=local           # local | supabase | s3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Default LLM provider (admin settings can override) ----------
LLM_PROTOCOL=openai            # openai | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1

LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
