# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=you@email.com
ENCRYPTION_KEY=                # 32 bytes base64: openssl rand -base64 32

# ---------- Supabase Auth ----------
# Local: `supabase status` gives these values. Cloud: dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# OAuth buttons — enable the provider on the Supabase side too:
# local: supabase/config.toml [auth.external.google]/[auth.external.linkedin_oidc]
#        + SUPABASE_AUTH_EXTERNAL_<PROVIDER>_CLIENT_ID/_SECRET in the shell env;
# cloud: dashboard → Authentication → Providers (LinkedIn (OIDC)).
NEXT_PUBLIC_AUTH_GOOGLE=false
# NEXT_PUBLIC_AUTH_GITHUB=false
NEXT_PUBLIC_AUTH_LINKEDIN=false

# ---------- Database (Neon, Supabase or local Postgres) ----------
# Runtime queries — on Vercel this MUST be a pooled, IPv4-compatible
# connection: Supabase's direct host (db.<ref>.supabase.co:5432) is
# IPv6-only on the free tier and unreachable from serverless functions.
# Supabase dashboard → Connect → "Transaction pooler" (port 6543):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@localhost:5432/cvgen
# Used only by `prisma migrate`: needs a non-transaction-pooled connection
# for advisory locks. Supabase dashboard → Connect → "Session pooler"
# (also IPv4, port 5432 via the pooler host — not the direct db.* host):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local/single-instance Postgres: same value as DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/cvgen

# ---------- Transactional mail (support notifications) ----------
# Auth emails (confirmation, reset, invitations) are sent by Supabase Auth.
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=CVGen <no-reply@example.com>

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------- File storage ----------
STORAGE_DRIVER=local           # local | s3 | supabase
# s3: any S3-compatible storage. Cloudflare R2 recommended:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto, credentials from an R2 API token.
# Local dev alternative: the Supabase Docker S3 gateway
#   (S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3, S3_REGION=local).
S3_ENDPOINT=
S3_BUCKET=cvgen
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=                 # optional: public R2 bucket/custom domain; empty = private proxy via /api/files
# supabase driver (REST):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cvgen

# ---------- Rate limiting (multi-instance) ----------
# Optional. Without these, limits are in-memory per process (fine for local / single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Health probe: Bearer token unlocks detailed checks (stripe/llm/mailer/upstash).
HEALTH_SECRET=

# ---------- Sentry (error monitoring) ----------
# Dashboard → Settings → Projects → Client Keys (DSN). Leave empty locally to disable.
NEXT_PUBLIC_SENTRY_DSN=https://84f3f6768ab02a2f4d5eba207a1875cd@o4511915217321984.ingest.de.sentry.io/4511915220729936
# Build-time only (Vercel): source maps. Do NOT commit SENTRY_AUTH_TOKEN.
# SENTRY_ORG=veyala
# SENTRY_PROJECT=javascript-nextjs
# SENTRY_AUTH_TOKEN=

# ---------- Default LLM provider (admin settings can override) ----------
LLM_PROTOCOL=openai            # openai | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1

LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
