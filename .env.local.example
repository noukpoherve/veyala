# ---------- App ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changez-moi-avec-openssl-rand-base64-32
ADMIN_EMAILS=ton@email.com
ENCRYPTION_KEY=                # 32 octets base64 : openssl rand -base64 32

# ---------- Base de données (Neon, Supabase ou Postgres local) ----------
DATABASE_URL=postgresql://user:password@localhost:5432/cvgen

# ---------- Auth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=CVGen <no-reply@example.com>

# ---------- Stripe (mode test) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------- Stockage fichiers ----------
STORAGE_DRIVER=local           # local | supabase | s3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- LLM par défaut (surcharge possible via l'admin) ----------
LLM_PROTOCOL=openai            # openai | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1
