generator client {
  provider      = "prisma-client-js"
  // native = machine that runs `prisma generate`; darwin-arm64 = Apple Silicon
  // local; debian-openssl-3.0.x = Vercel / most Linux Node 20+ runtimes.
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries: pooled connection (IPv4-compatible, required for
  // serverless — Supabase's direct host is IPv6-only on the free tier).
  url       = env("DATABASE_URL")
  // `prisma migrate` only: session-mode pooled connection (also IPv4,
  // supports the advisory locks migrations need — the transaction pooler
  // used by DATABASE_URL does not).
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (Supabase Auth + Prisma profile) ----------

enum Role {
  USER
  ADMIN
}

enum ArchiveSource {
  SELF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  /// Supabase Auth user id (auth.users.id); app tables keep their cuid FKs.
  authId        String?   @unique @db.Uuid
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  /// Set when the first-run product tour is skipped or completed.
  tourDismissedAt DateTime?
  /// Soft-deactivation: account is inaccessible until an admin restores it.
  archivedAt    DateTime?
  archivedBy    ArchiveSource?
  archiveReason String?

  credits            Credits?
  creditTransactions CreditTransaction[]
  payments           Payment[]
  promoCodesCreated  PromoCode[]         @relation("PromoCodeCreator")
  baseProfile        BaseProfile?
  templates          Template[]
  generatedCVs       GeneratedCV[]
  generationJobs     GenerationJob[]
  supportThreads     SupportThread[]
  adminAuditLogs     AdminAuditLog[]
  activityAsActor    ActivityLog[]       @relation("ActivityActor")
  activityAsSubject  ActivityLog[]       @relation("ActivitySubject")

  @@index([archivedAt])
}

// ---------- Support inbox (user ↔ admin messaging) ----------

enum ThreadStatus {
  OPEN
  CLOSED
}

model SupportThread {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  status    ThreadStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  fromAdmin Boolean  @default(false)
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ---------- Crédits & paiements ----------

enum CreditReason {
  PURCHASE
  GENERATION
  ADMIN_ADJUST
  SIGNUP_BONUS
  REFUND
}

model Credits {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  delta     Int
  reason    CreditReason
  refId     String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // Prevents double-crediting the same purchase/generation (NULL refId allowed many times).
  @@unique([reason, refId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  stripeSessionId     String        @unique
  stripePaymentIntent String?       @unique
  packId              String?
  promoCodeId         String?
  amountCents         Int
  discountCents       Int           @default(0)
  currency            String        @default("eur")
  creditsPurchased    Int
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack      Pack?      @relation(fields: [packId], references: [id], onDelete: SetNull)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([promoCodeId])
}

model Pack {
  id         String  @id @default(cuid())
  label      String
  priceCents Int
  credits    Int
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  payments   Payment[]
  promoCodes PromoCode[]
}

enum PromoKind {
  PERCENT
  FIXED_CENTS
  BONUS_CREDITS
}

/** App-owned promo codes applied before Stripe Checkout (amount/credits fixed on Payment). */
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  kind            PromoKind
  percentOff      Int?
  amountOffCents  Int?
  bonusCredits    Int?
  packId          String?
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  perUserLimit    Int       @default(1)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pack      Pack?     @relation(fields: [packId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("PromoCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([active, expiresAt])
}

// ---------- CV ----------

model BaseProfile {
  userId        String   @id
  data          Json
  sourceFileUrl String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TemplateEngine {
  DOCX
  HTML
}

model Template {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  ownerId         String?
  status          TemplateStatus @default(DRAFT)
  engine          TemplateEngine @default(HTML)
  fingerprint     String         @unique
  /** sha256 of the uploaded reference image: exact re-uploads dedupe without the LLM. */
  sourceImageHash String?        @unique
  previewImageUrl String?
  definition      Json
  isPublic        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  generatedCVs GeneratedCV[]

  @@index([status, isPublic])
}

enum GenerationUniverse {
  EMPLOYMENT
  CAMPUS_FRANCE
}

model GeneratedCV {
  id           String             @id @default(cuid())
  userId       String
  templateId   String
  universe     GenerationUniverse @default(EMPLOYMENT)
  jobTitle     String
  jobSource    String
  jobText      String             @db.Text
  jobTextHash  String
  tailoredData Json
  /** Per-CV colour overrides applied on top of the template palette (nullable). */
  styleOverride Json?
  docxUrl      String?
  pdfUrl       String?

  coverLetter        String  @default("") @db.Text
  coverLetterDocxUrl String?
  coverLetterPdfUrl  String?

  /** Deterministic match % vs the job/formation checklist (0–100), before / after. */
  matchScoreBefore Int?
  matchScoreAfter  Int?
  matchBreakdown   Json?

  /** Client idempotency key — retries after success return the same row. */
  idempotencyKey String?

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, universe, createdAt])
  @@index([jobTextHash])
}

/**
 * Cached structured job checklist. LLM extracts once per jobTextHash; later
 * matching is deterministic and costs zero tokens.
 */
model JobAnalysis {
  id          String   @id @default(cuid())
  jobTextHash String   @unique
  title       String   @default("")
  mustHave    String[] @default([])
  niceHave    String[] @default([])
  tools       String[] @default([])
  softSkills  String[] @default([])
  /** "llm" | "heuristic" */
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Cached structured formation checklist for Campus France coherence matching.
 * LLM extracts once per programTextHash; later scoring is deterministic.
 */
model FormationAnalysis {
  id                String   @id @default(cuid())
  programTextHash   String   @unique
  title             String   @default("")
  domain            String   @default("")
  level             String   @default("")
  prerequisites     String[] @default([])
  objectives        String[] @default([])
  targetSkills      String[] @default([])
  outcomes          String[] @default([])
  selectionCriteria String[] @default([])
  /** "llm" | "heuristic" */
  source            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/**
 * Async CV generation job: progress is persisted so the UI can poll even if
 * the long-running worker request is interrupted.
 */
model GenerationJob {
  id             String              @id @default(cuid())
  userId         String
  universe       GenerationUniverse  @default(EMPLOYMENT)
  status         GenerationJobStatus @default(QUEUED)
  /** Current pipeline step id (reading_offer, adapting_cv, …). */
  step           String?
  message        String?
  scoreBefore    Int?
  scoreAfter     Int?
  error          String?
  errorStatus    Int?
  /** Serialized GenerateParams (without userId). */
  params         Json
  idempotencyKey String?
  /** Credit ledger refId (gen_<key> or gen_<jobId>). */
  attemptId      String
  generatedCvId  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/** Append-only audit trail for privileged admin actions (STRIDE — Repudiation). */
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/**
 * Append-only product/security activity trail (user + admin).
 * Actor/subject FKs use SetNull so hard-delete does not erase the history.
 */
model ActivityLog {
  id            String   @id @default(cuid())
  actorId       String?
  subjectUserId String?
  action        String
  meta          Json?
  createdAt     DateTime @default(now())

  actor   User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User? @relation("ActivitySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([action, createdAt])
}

// ---------- Config LLM (admin) ----------

enum LLMProtocol {
  openai
  anthropic
}

model LLMProvider {
  id        String      @id @default(cuid())
  name      String
  protocol  LLMProtocol @default(openai)
  baseUrl   String
  model     String
  apiKeyEnc String?
  active    Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
}

// ---------- Blog CMS ----------

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum BlogCategory {
  CV
  ATS
  LETTRE
  EMPLOI
  ETUDES
  IA
}

model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String
  excerpt        String
  category       BlogCategory
  tags           String[]       @default([])
  keywords       String[]       @default([])
  focusKeyword   String?
  status         BlogPostStatus @default(DRAFT)
  featured       Boolean        @default(false)
  accent         String         @default("#2563EB")
  authorName     String         @default("Équipe Veyala")
  authorRole     String         @default("Experts CV, ATS & candidature")
  /// Structured article body (ContentBlock[]).
  body           Json
  /// Optional FAQ for FAQPage JSON-LD.
  faq            Json?
  /// Markdown source edited in admin (kept in sync with `body` on save).
  bodyMarkdown   String         @db.Text
  readingTimeMin Int            @default(5)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([featured, status])
  @@index([category, status])
}
