generator client {
  provider      = "prisma-client-js"
  // native = machine that runs `prisma generate`; darwin-arm64 = Apple Silicon
  // local; debian-openssl-3.0.x = Vercel / most Linux Node 20+ runtimes.
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries: pooled connection (IPv4-compatible, required for
  // serverless — Supabase's direct host is IPv6-only on the free tier).
  url       = env("DATABASE_URL")
  // `prisma migrate` only: session-mode pooled connection (also IPv4,
  // supports the advisory locks migrations need — the transaction pooler
  // used by DATABASE_URL does not).
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (Supabase Auth + Prisma profile) ----------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  /// Supabase Auth user id (auth.users.id); app tables keep their cuid FKs.
  authId        String?   @unique @db.Uuid
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  credits            Credits?
  creditTransactions CreditTransaction[]
  payments           Payment[]
  baseProfile        BaseProfile?
  templates          Template[]
  generatedCVs       GeneratedCV[]
  generationJobs     GenerationJob[]
  supportThreads     SupportThread[]
  adminAuditLogs     AdminAuditLog[]
}

// ---------- Support inbox (user ↔ admin messaging) ----------

enum ThreadStatus {
  OPEN
  CLOSED
}

model SupportThread {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  status    ThreadStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  fromAdmin Boolean  @default(false)
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ---------- Crédits & paiements ----------

enum CreditReason {
  PURCHASE
  GENERATION
  ADMIN_ADJUST
  SIGNUP_BONUS
  REFUND
}

model Credits {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  delta     Int
  reason    CreditReason
  refId     String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  stripeSessionId     String        @unique
  stripePaymentIntent String?
  amountCents         Int
  currency            String        @default("eur")
  creditsPurchased    Int
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Pack {
  id         String  @id @default(cuid())
  label      String
  priceCents Int
  credits    Int
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

// ---------- CV ----------

model BaseProfile {
  userId        String   @id
  data          Json
  sourceFileUrl String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TemplateEngine {
  DOCX
  HTML
}

model Template {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  ownerId         String?
  status          TemplateStatus @default(DRAFT)
  engine          TemplateEngine @default(HTML)
  fingerprint     String         @unique
  /** sha256 of the uploaded reference image: exact re-uploads dedupe without the LLM. */
  sourceImageHash String?        @unique
  previewImageUrl String?
  definition      Json
  isPublic        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  generatedCVs GeneratedCV[]

  @@index([status, isPublic])
}

model GeneratedCV {
  id           String   @id @default(cuid())
  userId       String
  templateId   String
  jobTitle     String
  jobSource    String
  jobText      String   @db.Text
  jobTextHash  String
  tailoredData Json
  /** Per-CV colour overrides applied on top of the template palette (nullable). */
  styleOverride Json?
  docxUrl      String?
  pdfUrl       String?

  coverLetter        String  @default("") @db.Text
  coverLetterDocxUrl String?
  coverLetterPdfUrl  String?

  /** Deterministic match % vs the job checklist (0–100), before / after tailoring. */
  matchScoreBefore Int?
  matchScoreAfter  Int?
  matchBreakdown   Json?

  /** Client idempotency key — retries after success return the same row. */
  idempotencyKey String?

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([jobTextHash])
}

/**
 * Cached structured job checklist. LLM extracts once per jobTextHash; later
 * matching is deterministic and costs zero tokens.
 */
model JobAnalysis {
  id          String   @id @default(cuid())
  jobTextHash String   @unique
  title       String   @default("")
  mustHave    String[] @default([])
  niceHave    String[] @default([])
  tools       String[] @default([])
  softSkills  String[] @default([])
  /** "llm" | "heuristic" */
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/**
 * Async CV generation job: progress is persisted so the UI can poll even if
 * the long-running worker request is interrupted.
 */
model GenerationJob {
  id             String              @id @default(cuid())
  userId         String
  status         GenerationJobStatus @default(QUEUED)
  /** Current pipeline step id (reading_offer, adapting_cv, …). */
  step           String?
  message        String?
  scoreBefore    Int?
  scoreAfter     Int?
  error          String?
  errorStatus    Int?
  /** Serialized GenerateParams (without userId). */
  params         Json
  idempotencyKey String?
  /** Credit ledger refId (gen_<key> or gen_<jobId>). */
  attemptId      String
  generatedCvId  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/** Append-only audit trail for privileged admin actions (STRIDE — Repudiation). */
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ---------- Config LLM (admin) ----------

enum LLMProtocol {
  openai
  anthropic
}

model LLMProvider {
  id        String      @id @default(cuid())
  name      String
  protocol  LLMProtocol @default(openai)
  baseUrl   String
  model     String
  apiKeyEnc String?
  active    Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
}
