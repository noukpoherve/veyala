generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Auth.js v5) ----------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  credits            Credits?
  creditTransactions CreditTransaction[]
  payments           Payment[]
  baseProfile        BaseProfile?
  templates          Template[]
  generatedCVs       GeneratedCV[]
  emailVerification  EmailVerification?
}

// One-time 6-digit code emailed at sign-up; the hash only is stored.
model EmailVerification {
  id         String   @id @default(cuid())
  userId     String   @unique
  codeHash   String
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  attempts   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Crédits & paiements ----------

enum CreditReason {
  PURCHASE
  GENERATION
  ADMIN_ADJUST
  SIGNUP_BONUS
  REFUND
}

model Credits {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  delta     Int
  reason    CreditReason
  refId     String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  stripeSessionId     String        @unique
  stripePaymentIntent String?
  amountCents         Int
  currency            String        @default("eur")
  creditsPurchased    Int
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Pack {
  id         String  @id @default(cuid())
  label      String
  priceCents Int
  credits    Int
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

// ---------- CV ----------

model BaseProfile {
  userId        String   @id
  data          Json
  sourceFileUrl String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TemplateEngine {
  DOCX
  HTML
}

model Template {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  ownerId         String?
  status          TemplateStatus @default(DRAFT)
  engine          TemplateEngine @default(HTML)
  fingerprint     String         @unique
  /** sha256 of the uploaded reference image: exact re-uploads dedupe without the LLM. */
  sourceImageHash String?        @unique
  previewImageUrl String?
  definition      Json
  isPublic        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  generatedCVs GeneratedCV[]

  @@index([status, isPublic])
}

model GeneratedCV {
  id           String   @id @default(cuid())
  userId       String
  templateId   String
  jobTitle     String
  jobSource    String
  jobText      String   @db.Text
  jobTextHash  String
  tailoredData Json
  docxUrl      String?
  pdfUrl       String?

  coverLetter        String  @default("") @db.Text
  coverLetterDocxUrl String?
  coverLetterPdfUrl  String?

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@index([userId, createdAt])
}

// ---------- Config LLM (admin) ----------

enum LLMProtocol {
  openai
  anthropic
}

model LLMProvider {
  id        String      @id @default(cuid())
  name      String
  protocol  LLMProtocol @default(openai)
  baseUrl   String
  model     String
  apiKeyEnc String?
  active    Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
}
