{
  "name": "cvgen",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "supabase:start": "set -a && [ -f supabase/.env.oauth ] && . ./supabase/.env.oauth; set +a && supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status -o env",
    "supabase:restart": "npm run supabase:stop && npm run supabase:start",
    "dev:clean": "rm -rf .next && next dev",
    "setup:pdf": "playwright install chromium",
    "emails:write": "tsx scripts/write-auth-emails.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.73.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.0.2",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.2",
    "next": "^14.2.5",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.4",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": "biome check --write --no-errors-on-unmatched"
  }
}
